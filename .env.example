# ==============================================================================
# Notepad.do — Environment Variables Template for Dokploy & Production
# ==============================================================================

# 1. PostgreSQL Database URL (Required)
# Format: postgres://username:password@host:port/database?sslmode=require
DATABASE_URL=postgres://postgres:tu_password@tu_host_postgres:5432/notepad?sslmode=disable

# 2. Master Admin Key (Required for /admin dashboard authentication)
ADMIN_API_KEY=TommyAdminSecret2026!

# 3. Server Port (Default is 8080)
PORT=8080

# 4. Frontend API URL for Dokploy
# - If deploying separate services: set to your backend public URL (e.g. https://api.notepad.do)
# - If deploying unified container or docker-compose with proxy: leave EMPTY
VITE_API_URL=

# 5. Allowed CORS Origins (Comma-separated URLs or * for all)
CORS_ORIGINS=*

# 6. OxaPay Cryptocurrency Integration (Optional)
OXAPAY_MERCHANT_KEY=
OXAPAY_WEBHOOK_SECRET=

# 7. Google AdSense Integration (Optional - can be set at build time in Vite or live from /admin/)
# Format: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT_ID=
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_BOTTOM=


